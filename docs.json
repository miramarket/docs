{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Miramarket Docs",
  "colors": {
    "primary": "#3100FF",
    "light": "#4B22FF",
    "dark": "#2100B8"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Start here",
        "groups": [
          {
            "group": "Learn Miramarket",
            "pages": [
              "index",
