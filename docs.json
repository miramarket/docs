              "strategy-builder/tutorial",
              "strategy-builder/examples",
              "strategy-builder/glossary"
            ]
          }
        ]
      },
      {
        "tab": "Strategy builder",
        "groups": [
          {
            "group": "Using the builder",
            "pages": [
              "strategy-builder/overview",
              "strategy-builder/build-a-strategy",
              "strategy-builder/markets",
              "strategy-builder/conditions",
              "strategy-builder/actions",
              "strategy-builder/recurring-markets",
              "strategy-builder/run-demo-live",
              "strategy-builder/validation"
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "groups": [
          {
            "group": "Command line",
            "pages": [
              "cli"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Quickstart",
          "href": "/quickstart",
          "icon": "rocket"
        },
        {
          "anchor": "Glossary",
          "href": "/strategy-builder/glossary",
          "icon": "book-open"
        },
        {
          "anchor": "Run demo or live",
          "href": "/strategy-builder/run-demo-live",
          "icon": "play"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/miramarket-icon.png",
    "dark": "/logo/miramarket-icon.png"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Launch App",
      "href": "https://app.miramarket.org"
    }
